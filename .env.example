# Kopiraj u .env.local (razvoj) ili .env (produkcija na VPS-u) i popuni vrednosti.

# ── Kanonski URL sajta ────────────────────────────────────────────────
# Koristi se za metadata, sitemap.xml, robots.txt i JSON-LD.
NEXT_PUBLIC_SITE_URL=https://spartansgym.rs

# ── Kontakt forma (Resend) ───────────────────────────────────────────
RESEND_API_KEY=

# Pošiljalac. Dok domen nije verifikovan u Resend-u ostavi onboarding adresu.
# Posle verifikacije: "Spartans Gym <kontakt@spartansgym.rs>"
RESEND_FROM=Spartans Gym <onboarding@resend.dev>

# Primalac upita. Dok domen nije verifikovan, Resend šalje samo na adresu
# vlasnika Resend naloga. Posle verifikacije prebaci na mejl teretane:
# fitnesscentarspartansgym@gmail.com
LEAD_TO=slavisaarsenijevic05@gmail.com

# Opciona BCC kopija upita (npr. lični mejl).
LEAD_BCC=

# ── Kopija lead-a u Google Sheet ─────────────────────────────────────
# URL Google Apps Script Web App-a koji upisuje red u tabelu. Ostavi prazno
# da se preskoči.
GOOGLE_SHEET_WEBHOOK_URL=

# ── Google Analytics 4 ──────────────────────────────────────────────
# Measurement ID (G-XXXXXXXXXX). Ostavi prazno da se GA i cookie baner
# uopšte ne učitavaju.
NEXT_PUBLIC_GA_ID=
